{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiiisiii.dev/contracts/task-v1.schema.json",
  "title": "hiiisiii.task.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "sequence", "operation", "target_id", "base_ref", "base_sha", "workdir", "commands", "patch", "output_limit"],
  "properties": {
    "schema": {"const": "hiiisiii.task.v1"},
    "request_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "operation": {"enum": ["inspect", "apply", "verify"]},
    "target_id": {"const": "local"},
    "base_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "base_sha": {"type": ["string", "null"]},
    "workdir": {"type": "string", "minLength": 1, "maxLength": 1024},
    "commands": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "run", "timeout_sec"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "run": {"type": "string", "minLength": 1, "maxLength": 4000},
          "timeout_sec": {"type": "integer", "minimum": 1, "maximum": 900}
        }
      }
    },
    "patch": {"type": ["string", "null"]},
    "output_limit": {"type": "integer", "minimum": 1, "maximum": 24000}
  }
}
